# Keep the build context small and, more importantly, keep host-specific state
# out of the image: the local .env, the local database, and public/storage
# (an absolute symlink into this machine's filesystem that would arrive broken).

.git
.gitignore
.gitattributes

.env
.env.backup
.env.production

vendor
node_modules

database/*.sqlite
database/*.sqlite-journal

public/storage
public/build
public/hot

storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/testing/*
storage/framework/views/*
storage/pail

.phpunit.result.cache
.phpunit.cache

Dockerfile
.dockerignore
docker-compose.yml

.idea
.vscode
.editorconfig
